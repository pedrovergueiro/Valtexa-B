# Modelo usado quando a requisicao nao informa qual quer.
# Chaves disponiveis: leaf-foliar, rover-understory, aerial-canopy (ver MODELS.md).
DEFAULT_MODEL=leaf-foliar

# Diretorios. Relativos sao resolvidos a partir da raiz do repo.
MODELS_DIR=models
DATA_DIR=data

# Opcional: sobrescreve os pesos APENAS do modelo padrao.
# Existe para compatibilidade com deploys que ja apontam MODEL_PATH.
# MODEL_PATH=models/corn_disease_model.keras
# LABELS_PATH=models/corn_disease_model.labels.json

# Confianca minima para o resultado ser conclusivo. Abaixo disso a resposta
# vem com "abstained": true. 0.0 desliga a abstencao.
#
# Recomendado em producao: 0.7. As imagens legitimas saem com confianca entre
# 0,999 e 1,000, enquanto entradas fora de escopo (folha de outra cultura, foto
# de cor chapada) saem entre 0,43 e 0,57 - abster nessa faixa custa quase nada e
# intercepta o que a deteccao de novidade nao pega. Fica em 0.0 aqui de
# proposito, para o exemplo refletir o padrao do codigo. Ver MODELS.md#novidade.
MIN_CONFIDENCE=0.0

# Ciclo de dados proprio (ver MODELS.md).
# Regula o volume da fila de revisao: menor = mais imagens marcadas.
#
# Em 1.0 a novidade pega 3 de 7 entradas fora de escopo sem marcar nenhuma
# imagem boa. Em 0.8 pega 5 de 7, ao custo de 2% de falso alarme. Escolha pelo
# tempo do agronomo, nao pela acuracia.
NOVELTY_SENSITIVITY=1.0
# Onde arquivar as imagens que precisam de diagnostico do agronomo.
# Vazio = fila desligada (a API so marca needs_review na resposta).
# REVIEW_DIR=review

# Limites de upload.
MAX_UPLOAD_MB=10
MAX_BATCH_SIZE=20

# Origens do front, separadas por virgula. Use "*" apenas em desenvolvimento:
# com "*" as credenciais de CORS sao desativadas automaticamente.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
