# Modelo usado quando a requisicao nao informa qual quer.
# Chaves disponiveis: GET /models (ou /models/choices, agrupado por cultura).
DEFAULT_MODEL=leaf-foliar

# Versao que o rover usa por cultura quando manda so crop= (JSON). Vazio: a
# recomendada de cada cultura. Ex.: a versao comercial (so dados CC BY) da banana:
# ROVER_MODELS={"banana": "banana-foliar-cc"}
ROVER_MODELS={}

# Estado dos talhoes: fusao por planta, mapa e prevalencia (ver README, "Talhao").
# Vazio desliga: o rover responde so por quadro.
# FIELDS_DIR=fields

# Validacao de campo: guarda as probabilidades de cada recorte com a planta a que foi
# associado (FIELDS_DIR/plantas/registro/<talhao>.jsonl, ~25 KB por quadro). Com o
# rotulo do agronomo por planta, o training.fit_fusion recalibra a fusao com o rover.
FIELDS_TILE_LOG=false

# Diretorios. Relativos sao resolvidos a partir da raiz do repo.
MODELS_DIR=models
DATA_DIR=data

# Opcional: sobrescreve os pesos APENAS do modelo padrao.
# Existe para compatibilidade com deploys que ja apontam MODEL_PATH.
# MODEL_PATH=models/corn_disease_model.keras
# LABELS_PATH=models/corn_disease_model.labels.json

# Confianca minima para o resultado ser conclusivo. Abaixo disso a resposta
# vem com "abstained": true. 0.0 desliga a abstencao.
#
# Recomendado em producao: 0.7. As imagens legitimas saem com confianca entre
# 0,999 e 1,000, enquanto entradas fora de escopo (folha de outra cultura, foto
# de cor chapada) saem entre 0,43 e 0,57 - abster nessa faixa custa quase nada e
# intercepta o que a deteccao de novidade nao pega. Fica em 0.0 aqui de
# proposito, para o exemplo refletir o padrao do codigo. Ver MODELS.md#novidade.
MIN_CONFIDENCE=0.0

# TTA por padrao em /predict: preve em 4 orientacoes e tira a media. As
# acuracias do MODELS.md sao medidas assim (0,9555 contra 0,9498 sem TTA no
# leaf-foliar), mas custa 4x. Cada requisicao pode pedir com ?tta=true.
INFERENCE_TTA=false

# TTA nos recortes do rover (/predict/rover-frame). Desligado por padrao, medido:
# o TTA melhora o recorte (campo: banana 0,812 -> 0,822; citros 0,951 -> 0,969), mas
# piora a planta - no talhao de ponta a ponta o citros detectou 24 de 33 plantas
# doentes em vez de 29, sem menos alarme falso, porque a fusao por planta foi
# ajustada com saidas de uma passada so. Tambem custa quase o dobro por quadro.
ROVER_TTA=false

# Verificacao de especie (<pesos>.species.npz) nos recortes do rover. Desligada por
# padrao, medido: na foto avulsa ela barra 97% das folhas de outras especies, mas no
# talhao recusou 49% dos recortes de citros (pedaco de folha e fundo) e, com a mesma
# cabeca de diagnostico, levou os alarmes falsos em planta sadia de 0 para 12 de 33.
# No pomar o rover ja sabe a cultura da fileira.
ROVER_SPECIES_CHECK=false

# Recortes de cada quadro do rover que vao para a fila de revisao (precisa de
# REVIEW_DIR), no maximo: primeiro o estranho ao modelo, depois o de conjunto
# conformal ambiguo, e so um dos que o portao recusou. 0 desliga.
ROVER_REVIEW_PER_FRAME=3

# Quem executa os modelos: keras (padrao) ou onnx. Com onnx, a API usa os
# .onnx gravados por 'python -m training.export_onnx' e nao precisa de Keras nem
# torch - e o modo da ground station (ver requirements-edge.txt). Modelo sem
# .onnx cai para o Keras sozinho.
INFERENCE_RUNTIME=keras

# Ciclo de dados proprio (ver MODELS.md).
# Regula o volume da fila de revisao: menor = mais imagens marcadas.
#
# Em 1.0 a novidade pega 3 de 7 entradas fora de escopo sem marcar nenhuma
# imagem boa. Em 0.8 pega 5 de 7, ao custo de 2% de falso alarme. Escolha pelo
# tempo do agronomo, nao pela acuracia.
NOVELTY_SENSITIVITY=1.0
# Onde arquivar as imagens que precisam de diagnostico do agronomo.
# Vazio = fila desligada (a API so marca needs_review na resposta).
# REVIEW_DIR=review

# Limites de upload.
MAX_UPLOAD_MB=10
MAX_BATCH_SIZE=20

# Origens do front, separadas por virgula. Use "*" apenas em desenvolvimento:
# com "*" as credenciais de CORS sao desativadas automaticamente.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Token de serviço SaaS→IA (Authorization: Bearer). Com ele, toda rota exige o token
# — inclusive /metrics, que o Prometheus raspa com o mesmo valor. Vem do cofre.
SERVICE_TOKEN=

# Imagem para a IA do contorno (encaixe nos carreadores, ruas, obstáculos): molde XYZ,
# ex. https://.../{z}/{x}/{y}. Use o ortomosaico do cliente ou um provedor que licencie
# PROCESSAMENTO. A Esri e o Google licenciam exibir, não analisar (ver app/basemap.py).
# Vazio: /encaixe-carreador e /refine-boundary respondem 422 dizendo isso.
BASEMAP_TILES=
